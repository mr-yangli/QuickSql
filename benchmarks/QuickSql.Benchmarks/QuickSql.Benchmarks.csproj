<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>QuickSql.Benchmarks</RootNamespace>
    <Description>§12.8 的基准套件与门禁自检。两种跑法：不带参数 = BenchmarkDotNet 出数字；--gate = 拿门禁阈值判红绿并以退出码反馈。不是发布物。</Description>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- runtimeconfig.template.json 把 System.Runtime.TieredPGO 钉成 false：门禁（gate 模式）量的是
       PGO 关下的稳定分配基线。TieredPGO 的热方法重 JIT 会消装箱，且重 JIT 时机不确定——开着它，
       第 1/3 行的每行斜率随暖机状态翻（实测 556/604/592/652），warmup=25 钉不住。关掉后 warmup=25
       即逐字节确定（perRow 回到 736，与 net10 旧钉逐字一致）。这是结构性强制，不靠"记得设环境变量"。
       BDN 要量真实 PGO 暖机后的吞吐/分配，用 DOTNET_TieredPGO=1 覆盖本文件即可（环境变量优先于 runtimeconfig）。
       口径与 net11 增益声明的修正见 Gates.cs 门禁注释与 CHANGELOG 11.0.0。 -->

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- §12.8 第二行的对照组。见 Directory.Packages.props 里那句"不是引入第二个 ORM"。 -->
    <PackageReference Include="Dapper" />
    <!-- Live/ 一片的三方对照组（树册 §13 同款装置）。Offline/ 的门禁不碰它们：
         离线那片量"编排 + 物化"的分配账，Live 那片量"真驱动上的时间账"，两片的口径在册子里分着写。 -->
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
    <PackageReference Include="FreeSql.Provider.SqlServer" />
    <PackageReference Include="FreeSql.Provider.MySqlConnector" />
    <PackageReference Include="FreeSql.Provider.PostgreSQL" />
    <PackageReference Include="FreeSql.Provider.Xugu" />
    <PackageReference Include="SqlSugarCore" />
    <PackageReference Include="SqlSugar.XuguCoreNew" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickSql.Core\QuickSql.Core.csproj" />
    <ProjectReference Include="..\..\src\QuickSql.Providers.SqlServer\QuickSql.Providers.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\QuickSql.Providers.Sqlite\QuickSql.Providers.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\QuickSql.Providers.MySql\QuickSql.Providers.MySql.csproj" />
    <ProjectReference Include="..\..\src\QuickSql.Providers.PostgreSql\QuickSql.Providers.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\QuickSql.Providers.Xugu\QuickSql.Providers.Xugu.csproj" />
  </ItemGroup>

  <!-- 虚谷驱动厂商交付物（仓库只存字节、编译期不引用）Link 到输出 drivers/，与集成册同一手：
       DriverRegistry 运行期按程序集名 XuguClient 探测解析（信创现场把 DLL 丢进 drivers/ 的仓库内复刻）。 -->
  <ItemGroup>
    <None Include="..\..\src\QuickSql.Providers.Xugu\Driver\XuguClient.dll" Link="drivers\XuguClient.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- G1 在这里是真的：基准实体带 [Table]，编译期就生成 schema，
       于是 MetadataLookup / MaterializeWide 量到的是生成路径而不是反射兜底。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickSql.Generators\QuickSql.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
